{
  "name": "api-kapso-git",
  "version": "0.1.0",
  "description": "API NestJS para integrar Kapso con CRM Ventas.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.build.tsbuildinfo', { force: true });\"",
    "db:check": "ts-node scripts/db-check.ts",
    "env:database-url": "powershell -ExecutionPolicy Bypass -File scripts/ensure-database-url.ps1",
    "prebuild": "npm run clean",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\" \"docs/**/*.md\" \"tasks/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\" \"docs/**/*.md\" \"tasks/**/*.md\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "prestart:dev": "npm run clean",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "verify:start:dev": "powershell -ExecutionPolicy Bypass -File scripts/verify-start-dev.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-system.ps1",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:playwright": "playwright test",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mariadb": "^3.5.3",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@playwright/test": "^1.54.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    }
  }
}
