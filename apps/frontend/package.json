{
    "name": "crm-think-v2-frontend",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.28.2",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.28.2"
    },
    "type": "module",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.mjs",
        "predev": "node scripts/ensure-pnpm.mjs",
        "dev": "vite",
        "prebuild": "node scripts/ensure-pnpm.mjs",
        "build": "tsc --noEmit && vite build",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "preformat": "node scripts/ensure-pnpm.mjs",
        "format": "prettier \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs,html,ts}\" --write",
        "preformat:check": "node scripts/ensure-pnpm.mjs",
        "format:check": "prettier \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs,html,ts}\" --check",
        "prelint": "node scripts/ensure-pnpm.mjs",
        "lint": "eslint .",
        "prelint:fix": "node scripts/ensure-pnpm.mjs",
        "lint:fix": "eslint . --fix",
        "pretypecheck": "node scripts/ensure-pnpm.mjs",
        "typecheck": "tsc --noEmit",
        "pretest": "node scripts/ensure-pnpm.mjs",
        "test": "vitest run --passWithNoTests --dir test"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vitest": "^5.0.1"
    }
}
