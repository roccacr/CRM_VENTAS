# ============================================================================
# CRM TINK API - Variables locales de entorno
#
# Reglas:
# - Este archivo es solo plantilla. No debe contener credenciales reales.
# - El archivo real debe llamarse `.env` y esta ignorado por Git.
# - No usar `DATABASE_URL`: el runtime usa las variables DB_* tipadas abajo.
# - Nunca cambiar DB_NAME para apuntar al CRM viejo.
# - Si se necesita leer el CRM viejo, usar solo variables LEGACY_CRM_*.
# ============================================================================

# ============================================================================
# 1. Runtime del API
# ============================================================================
# Ambiente permitido: development, test o production.
NODE_ENV=development

# Puerto HTTP del API NestJS.
PORT=3000

# Host donde escucha el API. En desarrollo local debe quedarse en 127.0.0.1.
API_BIND_HOST=127.0.0.1

# Expone Swagger/OpenAPI solo cuando sea necesario. Por defecto queda apagado.
OPENAPI_ENABLED=false

# Nivel de logs estructurados JSON. No usar trace/debug en produccion sin motivo.
LOG_LEVEL=info

# ============================================================================
# 2. Seguridad HTTP, CORS y proxies
# ============================================================================
# Origin exacto del frontend. No debe tener path, query ni slash final.
FRONTEND_ORIGIN=http://localhost:5173

# Origins exactos adicionales para pruebas locales por IP de red, sin wildcard.
# Ejemplo: FRONTEND_ALLOWED_ORIGINS=http://192.168.100.8:5173,http://172.23.112.1:5173
FRONTEND_ALLOWED_ORIGINS=

# Proxies confiables separados por coma. Dejar vacio si no hay proxy local.
# No se permite "*", "0.0.0.0/0", "::/0" ni rangos demasiado amplios.
TRUSTED_PROXY_IPS=

# S09: protected GET/HEAD only, after profile validation. Initial conservative
# quotas, not load-validated. Effective IP uses TRUSTED_PROXY_IPS, not Origin.
# Each process has independent bounded user/IP stores; restart/eviction resets
# counters. S10 distributed enforcement remains pending.
AUTH_READ_USER_MAX=120
AUTH_READ_IP_MAX=600
AUTH_READ_WINDOW_MS=60000
AUTH_READ_CACHE=5000

# ============================================================================
# 3. Secretos locales del API
# ============================================================================
# Secreto para firmar cookies. Minimo 32 caracteres. No reutilizar en auditoria.
COOKIE_SECRET=replace-with-a-local-secret-of-at-least-32-characters

# Secreto HMAC para hashes de auditoria/rate limit. Debe ser distinto a COOKIE_SECRET.
AUDIT_HASH_SECRET=replace-with-a-different-local-secret-of-at-least-32-characters

# Secreto HMAC para hashear tokens opacos de sesion y refresh. Debe ser distinto
# a COOKIE_SECRET y AUDIT_HASH_SECRET. Nunca reutilizarlo para auditoria.
AUTH_TOKEN_HASH_SECRET=replace-with-a-third-local-secret-of-at-least-32-characters

# ============================================================================
# 4. Conexion MySQL - CRM nuevo
# ============================================================================
# Host MySQL que contiene la base nueva. No escribir secretos en esta plantilla.
DB_HOST=replace-with-mysql-host

# Puerto MySQL.
DB_PORT=3306

# Usuario MySQL dedicado al CRM nuevo. No usar usuario master/admin.
# Permisos esperados: lectura/escritura necesaria solo sobre CRM_THINK_V2.
DB_USER=replace-with-mysql-user

# Password del usuario MySQL. En el .env real se puede envolver en comillas si
# contiene caracteres especiales como #, %, $, ! o espacios.
DB_PASSWORD=replace-with-mysql-password

# Unica base permitida para este runtime.
DB_NAME=CRM_THINK_V2

# Debe ser true cuando DB_HOST no sea local o cuando el servidor MySQL exija TLS.
# Solo usar false para MySQL local/desarrollo controlado.
DB_SSL=false

# Ruta local al bundle CA de RDS/MySQL cuando DB_SSL=true.
# Para AWS RDS usar el bundle oficial de la region o global-bundle.pem.
# Nunca resolver TLS con rejectUnauthorized=false.
DB_SSL_CA=

# ============================================================================
# 5. Conexion MySQL - CRM viejo temporal (pool SELECT de solo lectura)
# ============================================================================
# Base vieja para sync/lectura temporal. Dejar vacio apaga la conexion legacy.
# No debe ser igual a DB_NAME.
ENABLE_LEGACY_FALLBACK=false
ENABLE_LEGACY_WRITES=false
# Enable only after native migrations 023/024 and audit privileges are reviewed.
# Never enables legacy writes or commercial restore endpoints.
ENABLE_RECORD_AUDIT=false
LEGACY_CRM_DB_NAME=

# Legacy reuses DB_HOST, DB_PORT, DB_USER, DB_PASSWORD and DB_SSL/DB_SSL_CA.
# The separate SELECT pool is read-only. Reading never enables catalog writes.
# All six writers additionally require ENABLE_LEGACY_WRITES=true and NODE_ENV=production.
# The approved LEGACY_CRM_DB_NAME must also be configured; empty disables writes.
# Catalog writers stay disabled in development/test.
# New contract-stage commands additionally require their live role/permission, central audit,
# exact legacy schema and ENABLE_LEGACY_WRITES=true; this explicit opt-in also works in development.
# They append stage events only, never update ordenventa or invoke the ERP.
# Before any production opt-in, approve dedicated least-privilege users with DBA.

# ============================================================================
# 6. Migraciones schema-only
# ============================================================================
# Doble confirmacion para el runner de migraciones. Debe coincidir con DB_NAME.
MIGRATION_CONFIRM_SCHEMA_ONLY=CRM_THINK_V2

# ============================================================================
# 7. Microsoft 365 / Entra ID
# ============================================================================
# Tenant de Microsoft Entra ID.
MICROSOFT_TENANT_ID=

# App registration client id.
MICROSOFT_CLIENT_ID=

# Client secret de la app registration. No guardar valor real en .env.example.
MICROSOFT_CLIENT_SECRET=

# Redirect URI exacta registrada en Entra ID.
MICROSOFT_REDIRECT_URI=

# Llave base64 de 32 bytes para cifrar cache MSAL en servidor.
MICROSOFT_MSAL_CACHE_ENCRYPTION_KEY=

# Scopes OIDC/Graph solicitados por el BFF.
MICROSOFT_SCOPES="openid profile email offline_access User.Read"

# ============================================================================
# 8. Login local - Rate limiting
# ============================================================================
# Reset de clave: limite por correo normalizado.
LOCAL_RESET_RATE_LIMIT_EMAIL_MAX=5

# Reset de clave: limite por IP. Debe ser mayor que el limite por correo por NAT.
LOCAL_RESET_RATE_LIMIT_IP_MAX=30

# Ventana del limite de reset en milisegundos.
LOCAL_RESET_RATE_LIMIT_WINDOW_MS=60000

# Cantidad maxima de llaves retenidas en memoria para reset.
LOCAL_RESET_RATE_LIMIT_CACHE=5000

# Completar reset: limite por token opaco de reset hasheado.
LOCAL_COMPLETE_RESET_RATE_LIMIT_TOKEN_MAX=5

# Completar reset: limite por IP. Debe ser mayor que el limite por token por NAT.
LOCAL_COMPLETE_RESET_RATE_LIMIT_IP_MAX=30

# Ventana del limite de completar reset en milisegundos.
LOCAL_COMPLETE_RESET_RATE_LIMIT_WINDOW_MS=60000

# Cantidad maxima de llaves retenidas en memoria para completar reset.
LOCAL_COMPLETE_RESET_RATE_LIMIT_CACHE=5000

# Login local: limite por correo normalizado.
LOCAL_LOGIN_RATE_LIMIT_EMAIL_MAX=5

# Login local: limite por IP. Debe ser mayor que el limite por correo por NAT.
LOCAL_LOGIN_RATE_LIMIT_IP_MAX=30

# Ventana del limite de login en milisegundos.
LOCAL_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Cantidad maxima de llaves retenidas en memoria para login.
LOCAL_LOGIN_RATE_LIMIT_CACHE=5000

# Microsoft start: limite por IP antes de enviar al usuario a Entra ID.
MICROSOFT_START_RATE_LIMIT_IP_MAX=30

# Ventana del limite de inicio Microsoft en milisegundos.
MICROSOFT_START_RATE_LIMIT_WINDOW_MS=60000

# Cantidad maxima de llaves retenidas en memoria para inicio Microsoft.
MICROSOFT_START_RATE_LIMIT_CACHE=5000

# Refresh: limite por refresh token hasheado. Debe ser mas estricto que IP.
REFRESH_RATE_LIMIT_TOKEN_MAX=3

# Refresh: limite por IP. Se mantiene mas alto para no castigar NAT corporativo.
REFRESH_RATE_LIMIT_IP_MAX=60

# Ventana del limite de refresh en milisegundos.
REFRESH_RATE_LIMIT_WINDOW_MS=60000

# Cantidad maxima de llaves retenidas en memoria para refresh.
REFRESH_RATE_LIMIT_CACHE=5000

# GET-only NetSuite adapter. Production preserves the fixed script=1764&deploy=1.
NETSUITE_ENVIRONMENT=production
# Sandbox requires its own credentials and the exact confirmed deployment URL.
# No sandbox URL default: supply script/deploy from the new confirmed deployment.
NETSUITE_SANDBOX_CONSUMER_KEY=
NETSUITE_SANDBOX_CONSUMER_SECRET=
NETSUITE_SANDBOX_TOKEN_ID=
NETSUITE_SANDBOX_TOKEN_SECRET=
NETSUITE_SANDBOX_REALM=4552704_SB1
NETSUITE_SANDBOX_RESTLET_URL=

# Native notes realtime. Single process does not require Redis.
NOTES_REALTIME_ENABLED=true
NOTES_REALTIME_TOPOLOGY=single
# For redis-streams only: authenticated rediss:// URL on a private network.
# NOTES_REALTIME_REDIS_URL=

# NetSuite Sandbox -> receptor local de diagnostico; prohibido en production.
NETSUITE_LOCAL_EVENTS_ENABLED=false
# NETSUITE_LOCAL_EVENTS_SECRET=<64 caracteres hexadecimales aleatorios y exclusivos>
