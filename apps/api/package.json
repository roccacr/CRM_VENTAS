{
    "name": "crm-think-v2-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.28.2"
    },
    "scripts": {
        "preinstall": "node ./scripts/ensure-pnpm.mjs",
        "dev": "node ./scripts/ensure-pnpm.mjs && tsx watch src/main.ts",
        "build": "node ./scripts/ensure-pnpm.mjs && tsc -p tsconfig.build.json",
        "check": "node ./scripts/ensure-pnpm.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "format": "node ./scripts/ensure-pnpm.mjs && prettier \"{src,scripts,migrations,test}/**/*.{ts,js,mjs}\" \"*.{json,mjs}\" --write",
        "format:check": "node ./scripts/ensure-pnpm.mjs && prettier \"{src,scripts,migrations,test}/**/*.{ts,js,mjs}\" \"*.{json,mjs}\" --check",
        "lint": "node ./scripts/ensure-pnpm.mjs && eslint .",
        "lint:fix": "node ./scripts/ensure-pnpm.mjs && eslint . --fix",
        "netsuite:package:test": "vitest run test/integrations/netsuite-package.spec.mjs",
        "netsuite:package": "node ./scripts/package-netsuite.mjs",
        "recover:owner": "node ./scripts/ensure-pnpm.mjs && tsx ./scripts/restore-owner-from-backup.ts",
        "migrate:identity:schema": "node ./scripts/ensure-pnpm.mjs && tsx ./scripts/run-schema-migrations.ts",
        "test": "node ./scripts/ensure-pnpm.mjs && vitest run --dir test",
        "test:coverage": "node ./scripts/ensure-pnpm.mjs && vitest run --dir test --coverage --maxWorkers=2",
        "test:mysql:ci": "node ./scripts/ensure-pnpm.mjs && tsx ./scripts/run-mysql-ci.ts",
        "typecheck": "node ./scripts/ensure-pnpm.mjs && tsc --noEmit"
    },
    "dependencies": {
        "@azure/msal-node": "^7.2.1",
        "@casl/ability": "^7.0.1",
        "@fastify/cookie": "^11.1.2",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@nestjs/common": "^12.1.0",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.0",
        "@nestjs/platform-fastify": "^12.1.0",
        "@nestjs/platform-socket.io": "12.1.0",
        "@nestjs/swagger": "^12.0.2",
        "@nestjs/websockets": "12.1.0",
        "@socket.io/redis-streams-adapter": "0.3.1",
        "argon2": "^0.45.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.2.2",
        "fastify": "5.12.6",
        "kysely": "^0.28.3",
        "mysql2": "^3.15.1",
        "nestjs-pino": "^5.2.1",
        "pino": "^10.3.1",
        "redis": "5.12.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "4.8.4",
        "ulid": "^3.0.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/testing": "^12.1.0",
        "@types/node": "^22.18.8",
        "@vitest/coverage-v8": "5.0.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.1",
        "fast-check": "^4.10.2",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "socket.io-client": "4.8.4",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.70.1",
        "vite": "8.3.3",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@10.28.2",
    "pnpm": {
        "overrides": {
            "@nestjs/platform-fastify>fastify": "5.12.6",
            "@fastify/rate-limit>ip-address": "10.7.4"
        }
    }
}
