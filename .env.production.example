# =============================================================================
# API Kapso - plantilla de produccion (copiar a .env en el servidor)
# El frontend CRM actual usa token_admin. Entra queda opcional/futuro.
# =============================================================================
NODE_ENV=production
PORT=8002
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=https://crm.roccacr.com
TRUST_PROXY_HOPS=1
INTERNAL_RATE_LIMIT_PER_MINUTE=120

# --- Microsoft Entra (opcional/futuro) ---
# No es requisito para el frontend CRM actual. Mantener solo si luego se expone
# un scope dedicado para esta API en el tenant.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=Kapso.Access
ENTRA_ALLOWED_CLIENT_IDS=

# Compatibilidad actual con el CRM: debe ser el mismo JWT_SECRET del backend CRM.
CRM_JWT_SECRET=replace_with_crm_backend_jwt_secret

# --- MySQL CRM (rellenar secretos reales del entorno prod) ---
MYSQL_HOST=db-crms.cfxfgwugknzb.us-east-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=replace_me
MYSQL_PASSWORD='replace_me'
MYSQL_DATABASE=crmdatabase-api
MYSQL_MIGRATIONS_RUN=false

# --- Jobs Kapso ---
# Produccion con una sola instancia: todo corre dentro del mismo API.
KAPSO_JOBS_DRIVER=local

# Redis/BullMQ NO forma parte del arranque normal de produccion.
# Solo se configura si se cambia explicitamente KAPSO_JOBS_DRIVER=bullmq
# para un despliegue futuro con varias replicas del API.
# REDIS_URL=rediss://:replace_me@redis-host:6379
# REDIS_HOST=replace_me
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=true

# --- Kapso / WhatsApp ---
KAPSO_MASTER_KEY_BASE64=replace_with_prod_base64_32_bytes
KAPSO_API_KEY=replace_with_prod_kapso_api_key
KAPSO_TEST_API_KEY=replace_with_prod_kapso_api_key
KAPSO_PROJECT_API_KEYS_JSON={"8067127b-c559-44ef-9f84-f20270911eec":"replace_with_prod_kapso_api_key"}
# URL publica de ESTA API (la que usa Kapso para webhooks y media)
KAPSO_PUBLIC_BASE_URL=https://kapso-crmventas.rdghub.com
KAPSO_SETUP_REDIRECT_BASE_URL=https://kapso-crmventas.rdghub.com
KAPSO_MEDIA_STORAGE_PATH=/var/kapso/archivos
KAPSO_MEDIA_MAX_FILE_SIZE_MB=100
KAPSO_MEDIA_SIGNING_SECRET=replace_with_at_least_32_random_characters_prod
KAPSO_MEDIA_SIGNED_URL_TTL_SECONDS=3600
KAPSO_WHATSAPP_WEBHOOK_SECRET=replace_with_prod_whatsapp_webhook_secret
KAPSO_META_WEBHOOK_SECRET=replace_with_prod_meta_webhook_secret
KAPSO_PLATFORM_WEBHOOK_SECRET=replace_with_prod_platform_webhook_secret
KAPSO_PENDING_SYNC_INTERVAL_MS=30000
KAPSO_PENDING_SYNC_BATCH_SIZE=10
KAPSO_LEAD_TEMPLATE_INTERVAL_MS=60000
