# Entorno base del API
NODE_ENV=development
PORT=8002
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://crm.roccacr.com
TRUST_PROXY_HOPS=1
INTERNAL_RATE_LIMIT_PER_MINUTE=120

# Microsoft Entra opcional/futuro.
# Puede quedar vacio si el CRM usa token_admin; si se configura tenant/audience,
# ENTRA_ALLOWED_CLIENT_IDS tambien debe configurarse para no aceptar cualquier app.
ENTRA_TENANT_ID=
# Audiences aceptadas por esta API. No son el usuario; son el recurso API.
# CSV: GUID (aud v2) + Application ID URI (aud cuando Expose an API usa api://...)
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=Kapso.Access
# Apps cliente autorizadas si luego se habilita Entra puro para esta API.
ENTRA_ALLOWED_CLIENT_IDS=
# Compatibilidad con la sesion actual del CRM.
# Debe ser el mismo JWT_SECRET del backend CRM; nunca va en el frontend.
CRM_JWT_SECRET=change_me_same_as_crm_backend_jwt_secret

# Conexion MySQL del CRM
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=crm_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=crmdatabase-api
MYSQL_MIGRATIONS_RUN=false

# Conexion Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Cifrado interno y API key base de Kapso
KAPSO_MASTER_KEY_BASE64=base64_32_bytes_key_here
KAPSO_API_KEY=kapso_project_api_key_here
KAPSO_TEST_API_KEY=kapso_project_api_key_here
KAPSO_PROJECT_API_KEYS_JSON={"kapso-project-id":"kapso_project_api_key_here"}
KAPSO_PUBLIC_BASE_URL=https://example.ngrok-free.dev
KAPSO_SETUP_REDIRECT_BASE_URL=http://localhost:8002
KAPSO_MEDIA_STORAGE_PATH=archivos
KAPSO_MEDIA_MAX_FILE_SIZE_MB=50
KAPSO_MEDIA_SIGNING_SECRET=replace_with_at_least_32_random_characters
KAPSO_MEDIA_SIGNED_URL_TTL_SECONDS=3600

# Secret del webhook Kapso tipo "WhatsApp / Kapso (events)"
KAPSO_WHATSAPP_WEBHOOK_SECRET=kapso_events_secret_here

# Secret del webhook Kapso tipo "Platform"
KAPSO_PLATFORM_WEBHOOK_SECRET=kapso_platform_secret_here
